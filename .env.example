# ------------------------------------------------------------------
# Supabase bağlantısı
# Supabase panelinde: Project Settings > API Keys bölümünden alın.
# Bu iki değer boşsa site "Yerel Demo Modu"nda çalışır (veriler .data/ içinde).
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo modunda oturum imzalamak için kullanılır (üretimde değiştir).
AUTH_SECRET=degistir-bunu-uzun-rastgele-bir-yazi-yap

# Sitenin kendi adresi (Supabase e-posta yönlendirmeleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
